// Phase 1 item 3, priority 3 (RK56 extension) verification: adaptive-dt
// RK56 (Fehlberg, solver(6)) baseline path using steps(). n=10 (< 20) stays
// below graphMinSteps, so the transparent Steps() graph dispatch is not
// attempted and this exercises the plain RK56.Step() path.
// Compare against _graph_poc_small_rk56_graph.mx3 via ovfdiff.
SetGridSize(64, 64, 1)
c := 4e-9
SetCellSize(c, c, c)

setsolver(6)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
steps(10)

save(m)
save(B_demag)
print("m_avg:", m.average())
print("step_count:", step)
print("t_final:", t)
