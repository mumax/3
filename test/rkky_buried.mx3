// Buried same-region cell must not carry RKKY (nearest-pair-only coupling).
// Stack (bottom -> top): region2 | region1 | spacer | region1(buried).
// The buried region-1 cell is separated from region 2 by BOTH the spacer and
// another region-1 cell, so it is not an interface and must carry no field;
// only the nearest region-1/region-2 pair couples.
//   interface field  |J/(Msat*dz)| = 2e-3/(1e6*0.9e-9) = 2.22222 T
//   region-1 average (interface + buried)/2 = 1.11111 T
//   E = -J A (m1.m2), A = (4*2e-9)^2 = 6.4e-17 m2, antiparallel:
//   E = -(-2e-3)(6.4e-17)(-1) = -1.28e-19 J  (a buried-coupled bug gives 1.5x)
SetGridSize(4, 4, 4)
SetCellSize(2e-9, 2e-9, 0.9e-9)
Msat = 1.0e6
defregion(2, layer(0))
defregion(1, layer(1).add(layer(3)))
ext_RKKY(1, 2, -2e-3)
m.setRegion(1, uniform(1, 0, 0))
m.setRegion(2, uniform(-1, 0, 0))
m.setRegion(0, uniform(0, 1, 0))
Run(0)
print("  B_rkky region1 avg :", B_rkky.Region(1).Average())
print("  B_rkky region2 avg :", B_rkky.Region(2).Average())
print("  B_rkky iz=3 buried  :", CropLayer(B_rkky, 3).Average())
print("  E_rkky          :", E_rkky.Get())
ExpectV("B_rkky region1 avg (buried cell zero)", B_rkky.Region(1).Average(), vector(1.11111, 0, 0), 1e-3)
ExpectV("B_rkky region2 (single nearest pair)", B_rkky.Region(2).Average(), vector(-2.22222, 0, 0), 1e-3)
Expect("E_rkky (one pair only)", E_rkky.Get(), -1.28e-19, 1e-21)
