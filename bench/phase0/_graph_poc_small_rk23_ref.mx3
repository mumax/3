// Phase 1 item 3, priority 3 (RK23 extension) verification: adaptive-dt
// RK23 (Bogacki-Shampine, solver(3)) baseline path using steps(). n=10 (< 20)
// stays below graphMinSteps, so the transparent Steps() graph dispatch is not
// attempted and this exercises the plain RK23.Step() path.
// Compare against _graph_poc_small_rk23_graph.mx3 via ovfdiff.
SetGridSize(64, 64, 1)
c := 4e-9
SetCellSize(c, c, c)

setsolver(3)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
steps(10)

save(m)
save(B_demag)
print("m_avg:", m.average())
print("step_count:", step)
print("t_final:", t)
