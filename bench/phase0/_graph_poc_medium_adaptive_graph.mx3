// Phase 1 item 3 PoC verification (Option B, medium grid): adaptive-dt (FixDt
// unset) CUDA Graph split-graph replay path using RunGraph(). Compare against
// _graph_poc_medium_adaptive_ref.mx3 via ovfdiff.
SetGridSize(256, 256, 1)
c := 4e-9
SetCellSize(c, c, c)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
setsolver(2)
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
RunGraph(200)

save(m)
save(B_demag)
print("m_avg:", m.average())
print("step_count:", step)
print("t_final:", t)
