// Phase 1 item 3, 3순위 prep (graphMaxCells re-tuning, see CLAUDE.md section
// 2.16(a)/2.17): 800x800x1 grid (640,000 cells, above graphMaxCells=500000),
// adaptive dt (FixDt unset), default solver (RK45DP, no setsolver() call),
// explicit CUDA Graph split-graph replay (RunGraph, bypasses the
// graphWorthwhile() cell-count gate via assertGraphCompatible() only).
// Compare against _graph_poc_800_rk45dp_nograph.mx3 (which, at 640,000 cells,
// is genuinely routed to RunWhile by the transparent dispatch's
// graphWorthwhile() check without any extra tricks) for a graph-vs-nograph
// throughput ratio just above the current threshold.
SetGridSize(800, 800, 1)
c := 4e-9
SetCellSize(c, c, c)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
t = 0
neval0 := Neval.get()
start := now()
RunGraph(100)
wall := since(start).Seconds()
nevl := Neval.get() - neval0

print("GRIDSIZE:", 800, "x", 800, "x", 1)
print("STEPS:", nevl)
print("WALLTIME_S:", wall)
print("CELLS_PER_S:", 800*800*1*nevl/wall)
print("S_PER_STEP:", wall/nevl)
