// Phase 1 item 3, priority 3 (RK23 extension) verification: adaptive-dt
// RK23 (Bogacki-Shampine, solver(3)) CUDA Graph replay path (runGraphRK23:
// split graphs execK2/execK3/execK4 for torqueFn(k2/k3/k4); Madd2/Madd4/
// error-estimate/MaxVecNorm/normalize/adaptDt/FSAL run uncaptured each step).
// n=10 (< 20) is below graphMinSteps, but RunGraph(n) bypasses that gate and
// dispatches directly via assertGraphCompatible().
// Compare against _graph_poc_small_rk23_ref.mx3 via ovfdiff.
SetGridSize(64, 64, 1)
c := 4e-9
SetCellSize(c, c, c)

setsolver(3)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
RunGraph(10)

save(m)
save(B_demag)
print("m_avg:", m.average())
print("step_count:", step)
print("t_final:", t)
