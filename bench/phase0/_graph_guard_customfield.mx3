// Phase 1 item 3 safety guard verification: RunGraph must reject custom
// field terms (AddFieldTerm) -- see CLAUDE.md section 2.12
// (assertGraphCompatible). Expected: util.AssertMsg panic ("RunGraph: custom
// field terms (AddFieldTerm) are not supported"), non-zero exit.
SetGridSize(64, 64, 1)
c := 4e-9
SetCellSize(c, c, c)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
setsolver(2)
b_ext = vector(0, 0.01, 0)
AddFieldTerm(ConstVector(0, 0, 0.001))

m = uniform(1, 0, 0)
steps(5) // warm-up

m = uniform(1, 0, 0)
RunGraph(5)
