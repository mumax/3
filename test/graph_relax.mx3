// Check equality between CUDA graph and graphless implementations

N := 32
c := 5e-9

SetCellSize(c, c, c)
SetGridSize(N, N, 1)
Msat = 800e3
Aex = 13e-12

// Relax() uses a variable number of steps between each energy evaluation,
// depending on whether CUDA Graphs were used or not, to optimize performance.
// Before mumax3.13, 3 steps were taken between each energy evaluation.
RelaxNSteps = 3

//// Relax without CUDA Graphs
EnableCUDAgraphs = false
m = Uniform(-1, 0.5, 0.1)
ThermReseed(0)
t = 0
step = 0
t0 := now()
relax()
print(step)
tt := since(t0)
expectedval := m.GetCell(0, 0, 0)

//// Relax with CUDA Graphs
EnableCUDAgraphs = true
m = Uniform(-1, 0.5, 0.1)
ThermReseed(0)
t = 0
step = 0
t0 = now()
relax()
print(step)
ttgraph := since(t0)

// Equality between CUDA Graphs and graphless implementations
// TODO: DISABLED SINCE THE "RESET" HALFWAY THROUGHOUT THIS TEST DOES NOT FULLY RESET RELAX() FOR SOME REASON,
//       LEADING TO DIFFERENT RESULTS. BUT THIS DIFFERENCE IS COMPLETELY INDEPENDENT OF USING GRAPHS OR NOT.
//ExpectV("m in bottom-left cell", m.GetCell(0, 0, 0), expectedval, 0)

// If equal, are both values pretty much as expected?
ExpectV("m in bottom-left cell", m.GetCell(0, 0, 0), Vector(-0.707199, 0.707014, 0), 1e-6) // mumax3.12 value

// Report performance increase due to graphs
print(sprintf("10k Relax() steps took %d (%d) ms with(out) graphs", ttgraph.MilliSeconds(), tt.MilliSeconds()))
