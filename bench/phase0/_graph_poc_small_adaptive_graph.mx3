// Phase 1 item 3 PoC verification (Option B): adaptive-dt (FixDt unset) CUDA
// Graph replay path (runGraphAdaptive: split graphs for torqueFn(dy0)/torqueFn(dy),
// Madd2/Madd3/MaxVecDiff/normalize/adaptDt run uncaptured each step).
// Compare against _graph_poc_small_adaptive_ref.mx3 via ovfdiff.
SetGridSize(64, 64, 1)
c := 4e-9
SetCellSize(c, c, c)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
setsolver(2)
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
RunGraph(500)

save(m)
save(B_demag)
print("m_avg:", m.average())
print("step_count:", step)
print("t_final:", t)
