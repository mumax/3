// Phase 1 item 3, 1순위 (large-grid generalization, see CLAUDE.md section
// 2.15): 1024x1024x1 grid, adaptive dt (FixDt unset), default solver (RK45DP,
// no setsolver() call), baseline (no CUDA Graph). Same config as
// _graph_poc_1024_rk45dp.mx3, but using steps() instead of RunGraph() for a
// fair before/after throughput comparison.
SetGridSize(1024, 1024, 1)
c := 4e-9
SetCellSize(c, c, c)

msat  = 800e3
aex   = 13e-12
alpha = 0.01
b_ext = vector(0, 0.01, 0)

m = uniform(1, 0, 0)
steps(5) // warm-up: kernel JIT load, FFT plan creation, buffer allocation

m = uniform(1, 0, 0)
t = 0
neval0 := Neval.get()
start := now()
steps(50)
wall := since(start).Seconds()
nevl := Neval.get() - neval0

print("GRIDSIZE:", 1024, "x", 1024, "x", 1)
print("STEPS:", nevl)
print("WALLTIME_S:", wall)
print("CELLS_PER_S:", 1024*1024*1*nevl/wall)
print("S_PER_STEP:", wall/nevl)
