// Buried same-region cell must not carry biquadratic RKKY (nearest-pair only).
// Stack (bottom -> top): region2 | region1 | spacer | region1(buried).
//   J1 = -2e-3, J2 = -0.5e-3, antiparallel (dot = -1):
//     pref = (J1 + 2*J2*dot)/(Msat*dz) = (-2e-3 + 1e-3)/(0.9e-3) = -1.11111 T
//     interface (iz=1): B = pref*m2 = (+1.11111, 0, 0)
//     region-1 average (interface + buried)/2 = (0.555556, 0, 0)
//     region-2 (iz=0):  B = pref*m1 = (-1.11111, 0, 0)
//   Energy (one pair): E = -J1*A*dot - J2*A*dot^2
//                        = -(-2e-3)(6.4e-17)(-1) - (-0.5e-3)(6.4e-17)(1)
//                        = -1.28e-19 + 3.2e-20 = -9.6e-20 J
//   (a buried-coupled bug gives 1.5x: -1.44e-19 J)
SetGridSize(4, 4, 4)
SetCellSize(2e-9, 2e-9, 0.9e-9)
Msat = 1.0e6
defregion(2, layer(0))
defregion(1, layer(1).add(layer(3)))
ext_RKKYBiquadratic(1, 2, -2e-3, -0.5e-3)
m.setRegion(1, uniform(1, 0, 0))
m.setRegion(2, uniform(-1, 0, 0))
m.setRegion(0, uniform(0, 1, 0))
Run(0)
print("  B_rkkybiquad region1 avg :", B_rkkybiquad.Region(1).Average())
print("  B_rkkybiquad region2 avg :", B_rkkybiquad.Region(2).Average())
print("  B_rkkybiquad iz=3 buried  :", CropLayer(B_rkkybiquad, 3).Average())
print("  E_rkkybiquad          :", E_rkkybiquad.Get())
ExpectV("B_rkkybiquad region1 avg (buried cell zero)", B_rkkybiquad.Region(1).Average(), vector(0.555556, 0, 0), 1e-3)
ExpectV("B_rkkybiquad region2 (single nearest pair)", B_rkkybiquad.Region(2).Average(), vector(-1.11111, 0, 0), 1e-3)
Expect("E_rkkybiquad (one pair only)", E_rkkybiquad.Get(), -9.6e-20, 1e-21)
