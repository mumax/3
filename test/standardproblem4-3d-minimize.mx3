/*
	Micromagnetic standard problem 4,
	with 3D discretization and minimize instead of relax
*/

// geometry
	setgridsize(128, 32, 2)
	setcellsize(500e-9/128, 125e-9/32, 3e-9/2)

// material
	Msat = 800e3
	Aex = 13e-12
	m  = uniform(1, .1, 0)

// minimize
	minimize()
	TOL := 1e-3
	expect("mx", m.average().X(), 0.9669952, TOL)
	expect("abs(my)", abs(m.average().Y()), 0.12521563, TOL)
	expect("mz", m.average().Z(), 0, TOL)
